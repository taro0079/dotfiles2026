# FZF
declare-user-mode fzf

define-command fzf-file -docstring 'search file by fzf' %{
    evaluate-commands %sh{
        dir=$(pwd)
        query_opt=""
        if [ "${#kak_selection}" -ge 2 ]; then
            query_opt="--query=\"$kak_selection\""
        fi
        cat <<EOF
        	terminal sh -c %{
            		preview='if command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always --line-range=:200 {}; else cat {}; fi'
            		f=\$(cd "$dir" && (fd --type f 2>dev/null || find . -type f) | fzf $query_opt --preview "\$preview" --preview-window=right:60%:wrap) || exit 0
            		[ -z "\$f" ] && exit 0
            		printf 'evaluate-commands -try-client %s edit %%{%s/%s}\n' "$kak_client" "$dir" "\$f" | kak -p "$kak_session"
        	}
EOF
    }
}

define-command fzf-buffer -docstring 'search buffer by fzf' %{
    evaluate-commands %sh{
        cat <<EOF
        	terminal sh -c %{
        	        preview='if command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always --line-range=:200 {}; else cat {}; fi'
        		f=\$(printf '%s\n' $kak_quoted_buflist | fzf --preview "\$preview") || exit 0;
        		[ -z "\$f"] && exit 0
        		printf "evaluate-commands -try-client '$kak_client' buffer '%s'" "\$f" | kak -p "$kak_session"
        	}
        EOF


    }
}
define-command fzf-grep -docstring 'grep by fzf' %{
    evaluate-commands %sh{
        dir=$(pwd)
        query_opt=""
        if [ "${#kak_selection}" -ge 2 ]; then
            query_opt="--query=\"$kak_selection\""
        fi
        cat <<EOF
        terminal sh -c %{
            # プレビュー: 該当行をハイライトし、その行へスクロールさせます（:200だと200行目以降の検索結果が見えないため）
            preview='if command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always --highlight-line {2} {1}; else cat {1}; fi'
            
            # 修正1: 検索コマンドから --color=always を削除
            if command -v rg >/dev/null 2>&1; then
                search_cmd="rg --line-number --no-heading --hidden '^'"
            else
                search_cmd="grep -rnI --exclude-dir='.git' '^' . 2>/dev/null"
            fi

            # 修正2: プレビューウィンドウが該当行(+{2}-/2)を追従するように修正
            selected=\$(eval "\$search_cmd" | fzf $query_opt --delimiter : --preview "\$preview" --preview-window=right:60%:wrap:+{2}-/2) || exit 0

            [ -z "\$selected" ] && exit 0

            f=\$(printf '%s\n' "\$selected" | cut -d: -f1)
            line=\$(printf '%s\n' "\$selected" | cut -d: -f2)

            # 修正3: printf の %%s を %s に修正
            printf 'evaluate-commands -try-client %s edit %%{%s/%s} %s\n' "$kak_client" "$dir" "\$f" "\$line" | kak -p "$kak_session"
        }
EOF
    }
}

define-command fzf-git-files -docstring "grep git ls-files by fzf" %{
    evaluate-commands %sh{
        cat <<EOF
        terminal sh -c %{
    		preview='if command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always --line-range=:200 {}; else cat {}; fi'
            selected=\$(git ls-files | fzf --preview "\$preview")
            if [ -n "\$selected" ]; then
                echo "evaluate-commands -try-client $kak_client edit %{\$selected}" | kak -p $kak_session   
            fi

        }
    }
}

define-command fzf-git-changes -docstring "grep git changed file by fzf" %{
    evaluate-commands %sh{
        cat <<EOF
        terminal sh -c %{
            preview='if command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always {2} ; else cat {2}; fi'
            selected=\$(git status -s -uall | grep -v '/\$' | grep -E -v '^(D|.D)' | while IFS= read -r line; do
                filepath=\$(echo "\$line" | cut -c4-)
                if [ ! -d "\$filepath" ]; then
                    echo "\$line"
                fi
            done | fzf --preview "\$preview" | cut -c4-)

            if [ -n "\$selected" ]; then
                echo "evaluate-commands -try-client $kak_client edit %{\$selected}" | kak -p $kak_session
            fi
        }
EOF
    }
}

