# erb / smarty は kak-lsp 標準の filetype フックがないので自前で lsp_servers を設定。
# kak-lsp 標準のフックは BufSetOption だが、これらは WinSetOption でも問題なく機能する。
hook global BufSetOption filetype=erb %{
    set-option buffer lsp_servers %{
        [herb]
        command = "herb-language-server"
        args = ["--stdio"]
        root_globs = ["Gemfile", ".git"]
    }
}

hook global BufSetOption filetype=smarty %{
    set-option buffer lsp_servers %{
        [html]
        command = "vscode-html-language-server"
        args = ["--stdio"]
        root_globs = [".git"]
        [html.settings.html.format]
        enable = false
    }
}


