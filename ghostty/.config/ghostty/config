font-family = "AcPlus IBM VGA 9x8"
font-size = 14
# font-thicken=true
font-feature=calt, liga, lig
theme = TokyoNight
window-theme = ghostty
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
cursor-style = block
fullscreen = false
cursor-opacity = 1
background-opacity =0.95
macos-titlebar-style= transparent
macos-option-as-alt=true
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
# background-blur = true
background-blur-radius = 20
desktop-notifications = true

# CRT-style post-processing shader
custom-shader = /Users/awesometaro/.config/ghostty/shaders/retro-terminal.glsl
custom-shader-animation = false
